APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=mamagift
POSTGRES_USER=mamagift
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql+psycopg://mamagift:change-me-for-local-use@localhost:5432/mamagift

AI_WORKER_BASE_URL=http://localhost:8090
AI_WORKER_TOKEN=local-fake-worker-token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2 ingestion.
STORAGE_ROOT=./var/storage
MAX_UPLOAD_BYTES=52428800
# Leave PARSER_STRATEGY_PATH unset while ADR-001 is PENDING EVIDENCE. Unset means no
# production parser is configured: development and CI fall back to the PyMuPDF
# baseline and mark every run degraded, and APP_ENV=production refuses to parse.
# PARSER_STRATEGY_PATH=configs/parser-strategy.example.json
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=30
PAGE_PREVIEW_DPI=110
VITE_API_URL=http://localhost:8000
